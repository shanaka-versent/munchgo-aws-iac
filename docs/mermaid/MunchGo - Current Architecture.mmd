---
config:
  layout: elk
---
flowchart TB
 subgraph PRESENTATION["Presentation Layer"]
    direction TB
        AUTH_C["AuthController"]
        BROWSE_C["BrowseController"]
        CUST_C["CustomerMvcController"]
        REST_C["RestaurantOwnerMvcController"]
        COUR_C["CourierMvcController"]
        ADMIN_C["AdminMvcController"]
  end
 subgraph VIEWS["View Layer - Thymeleaf SSR - 21 Templates"]
    direction TB
        V1["login / register"]
        V2["browse restaurants"]
        V3["customer dashboard"]
        V4["restaurant dashboard"]
        V5["courier dashboard"]
        V6["admin dashboard"]
  end
 subgraph SECURITY["Security - Spring Security 5.3"]
    direction TB
        FORM["Form-Based Login"]
        SESS["HTTP Sessions - JSESSIONID"]
        RBAC["Role-Based Access Control"]
  end
 subgraph SERVICES["Service Layer"]
    direction TB
        ORD_S["OrderService"]
        CON_S["ConsumerService"]
        RES_S["RestaurantService"]
        COU_S["CourierService"]
  end
 subgraph DOMAIN["Domain Layer"]
    direction LR
        E_COU["Courier"]
        E_CON["Consumer"]
        E_USR["User + Role"]
        E_ORD["Order + OrderLineItem"]
        E_RES["Restaurant + MenuItem"]
  end
    BROWSER["Web Browser"] --> PRESENTATION
    PRESENTATION --> VIEWS & SERVICES & SECURITY
    SERVICES --> DOMAIN
    DOMAIN --> DB[("Oracle Database - Single Shared Schema - 9 Tables")]

     AUTH_C:::presentation
